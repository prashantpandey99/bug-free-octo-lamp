{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "unicorn",
    "oxc"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": "off",
    "react/set-state-in-effect": "off",
    "unicorn/no-useless-fallback-in-spread": "off"
  },
  "env": {
    "builtin": true,
    "browser": true,
    "es2024": true
  }
}