# Legal Metrology Compliance & Inspection System
# Ministry of Consumer Affairs, Food & Public Distribution

# App Configuration
APP_NAME="Packaged Commodity Legal Metrology Compliance & Inspection System"
APP_ENV=development
DEBUG=True
PORT=8000
SECRET_KEY="doca_legal_metrology_sih_secure_jwt_secret_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (MySQL / SQLite)
# For MySQL: mysql+pymysql://username:password@localhost:3306/legal_metrology
# For SQLite fallback (zero setup): sqlite:///./legal_metrology.db
DATABASE_URL="sqlite:///./legal_metrology.db"

# Storage Configuration
UPLOAD_DIR="./uploads"
REPORT_DIR="./uploads/reports"
LABEL_DIR="./uploads/labels"

# OCR Configuration
# If tesseract is installed in custom path (e.g. C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_CMD=""
